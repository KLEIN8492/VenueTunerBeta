{
  "name": "venuetuner",
  "productName": "VenueTuner",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^25.1.8"
  },
  "description": "Live PA system processor and measurement tool",
  "author": "VenueTuner",
  "build": {
    "appId": "com.venuetuner.app",
    "productName": "VenueTuner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "x64ArchFiles": "Contents/Resources/engine/VenueTunerEngine",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "VenueTuner measures your sound system through the audio interface and the measurement microphone.",
        "NSHighResolutionCapable": true
      },
      "extraResources": [
        {
          "from": "../engine/build-universal/VenueTunerEngine",
          "to": "engine/VenueTunerEngine"
        }
      ]
    },
    "dmg": {
      "title": "VenueTuner ${version}",
      "background": "build/background.tiff",
      "iconSize": 88,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 510,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 590,
          "y": 72,
          "type": "file",
          "path": "build/READ ME FIRST.txt"
        },
        {
          "x": 70,
          "y": 72,
          "type": "file",
          "path": "../docs/manual/VenueTuner-Manual.pdf"
        }
      ]
    },
    "afterPack": "build/adhoc-sign.js",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../engine/build-win/VenueTunerEngine.exe",
          "to": "engine/VenueTunerEngine.exe"
        },
        {
          "from": "../docs/manual/VenueTuner-Manual.pdf",
          "to": "VenueTuner-Manual.pdf"
        },
        {
          "from": "build/READ ME FIRST - Windows.txt",
          "to": "READ ME FIRST - Windows.txt"
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VenueTuner-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio",
      "synopsis": "Live PA system processor and measurement tool",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../engine/build-linux/VenueTunerEngine",
          "to": "engine/VenueTunerEngine"
        },
        {
          "from": "../docs/manual/VenueTuner-Manual.pdf",
          "to": "VenueTuner-Manual.pdf"
        },
        {
          "from": "build/READ ME FIRST - Linux.txt",
          "to": "READ ME FIRST - Linux.txt"
        }
      ],
      "maintainer": "VenueTuner",
      "vendor": "VenueTuner"
    }
  }
}
